# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgres://echoseed:echoseed@localhost:5432/echoseed
DATABASE_URL_TEST=postgres://echoseed:echoseed@localhost:5432/echoseed_test

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage (audio uploads) - signed URL provider
STORAGE_PROVIDER=local
STORAGE_BUCKET=echoseed-audio
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_ENDPOINT=   http://localhost:9000

# Business rule thresholds (engineering config, not clinical claims)
CONSECUTIVE_FAILURE_THRESHOLD=5
MASTERY_MIN_ACCURACY=0.85
MASTERY_MIN_ATTEMPTS=10

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000
